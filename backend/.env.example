# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Settings → API

SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key — Dashboard → Settings → API → Publishable key
# Starts with: sb_publishable_   Used by auth middleware for token validation.
SUPABASE_ANON_KEY=sb_publishable_...

# Secret key — Dashboard → Settings → API → Secret key
# Starts with: sb_secret_   Used by supabaseAdmin for DB queries (bypasses RLS).
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy JWT format — still accepted as a fallback if you have older eyJ… keys.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
